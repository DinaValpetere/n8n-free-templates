    {
      "parameters": {
        "jsCode": "// Builds a Creatomate RenderScript: all clips play one after another on track 1.\n// 8 clips x 7.5s = 60s. Veo 3's own audio is kept.\nconst cfg = $('Config').first().json;\nconst clipSeconds = Number(cfg.clip_seconds) || 7.5;\nconst clipIds = $input.first().json.clip_ids;\nconst scenes = $('Split Out Scenes').all().map((i) => i.json);\n\nconst elements = clipIds.map((id, idx) => ({\n  type: 'composition',\n  track: 1,\n  duration: clipSeconds,\n  elements: [\n    {\n      type: 'video',\n      source: `https://drive.google.com/uc?export=download&id=${id}`,\n      duration: clipSeconds,\n      fit: 'cover',\n    },\n    {\n      type: 'text',\n      text: scenes[idx]?.stage ?? '',\n      y: '14%',\n      width: '90%',\n      x_alignment: '50%',\n      y_alignment: '50%',\n      font_family: 'Montserrat',\n      font_weight: '800',\n      font_size: '6 vmin',\n      fill_color: '#ffffff',\n      stroke_color: '#000000',\n      stroke_width: '1.2 vmin',\n    },\n  ],\n}));\n\nreturn [{\n  json: {\n    source: {\n      output_format: 'mp4',\n      width: 1080,\n      height: 1920,\n      frame_rate: 30,\n      elements,\n    },\n  },\n}];\n"
      },
      "id": "3f939fb1-2bc4-42d9-86ec-65db573b0141",
      "name": "Build 60s Timeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        -120
      ]
    },
